{
  "description": "Load the repository startup set and a per-prompt discipline digest into Codex context.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$(git rev-parse --show-toplevel)/.codex/hooks/load-context.sh\" session",
            "statusMessage": "Loading repository startup set",
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$(git rev-parse --show-toplevel)/.codex/hooks/load-context.sh\" prompt",
            "additionalContextLimit": 0
          }
        ]
      }
    ]
  }
}
