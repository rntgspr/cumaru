<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_UserFlows" targetNamespace="http://dot-llm.local/bpmn">
<bpmn2:process id="Process_UserFlows" name="dot-llm user flows" isExecutable="false">
<bpmn2:startEvent id="Start" name="dot-llm user flows"/>
<bpmn2:task id="Intent" name="User or LLM selects intent"/>
<bpmn2:task id="Dispatch" name="CLI dispatches command or skill recipe"/>
<bpmn2:exclusiveGateway id="Gateway" name="Select flow"/>
<bpmn2:endEvent id="End" name="Complete"/>
<bpmn2:task id="F_Doctor" name="Diagnose installed tree"/>
<bpmn2:textAnnotation id="Note_F_Doctor"><bpmn2:text>Code: six pillar-agnostic structural, marker, and tool checks.
Docs: run after install/update and around structural changes.</bpmn2:text></bpmn2:textAnnotation>
<bpmn2:task id="F_Install" name="Adopt framework flavor"/>
<bpmn2:textAnnotation id="Note_F_Install"><bpmn2:text>Code: copy flavor, install skills/commands, wire CLAUDE.md.
Docs: then edit domain/schema and run doctor.</bpmn2:text></bpmn2:textAnnotation>
<bpmn2:task id="F_Uninstall" name="Remove managed footprint"/>
<bpmn2:textAnnotation id="Note_F_Uninstall"><bpmn2:text>Fixed path: .llm/. Existing trees require index.md + schema.yaml before any managed artifact is removed.</bpmn2:text></bpmn2:textAnnotation>
<bpmn2:task id="F_Intake" name="Fetch or re-sync intake"/>
<bpmn2:textAnnotation id="Note_F_Intake"><bpmn2:text>Code: Jira, Linear, ClickUp adapters.
Docs: LLM refines RAW and adds pillar row; doctor warns while RAW remains.</bpmn2:text></bpmn2:textAnnotation>
<bpmn2:task id="F_Tag" name="Audit / get / set tags"/>
<bpmn2:textAnnotation id="Note_F_Tag"><bpmn2:text>Code and docs align on schema validation and marker preservation.</bpmn2:text></bpmn2:textAnnotation>
<bpmn2:task id="F_Flow" name="Move / copy / create / remove"/>
<bpmn2:textAnnotation id="Note_F_Flow"><bpmn2:text>All paths are canonically contained inside .llm.
Directory naming is enforced consistently across all verbs.</bpmn2:text></bpmn2:textAnnotation>
<bpmn2:task id="F_Update" name="Review or apply update"/>
<bpmn2:textAnnotation id="Note_F_Update"><bpmn2:text>Code: preserve frontmatter values and tag bodies; source prose by default.
Flavor is detected from .llm/schema.yaml, with base fallback.</bpmn2:text></bpmn2:textAnnotation>
<bpmn2:task id="F_Skills" name="Update skills only"/>
<bpmn2:textAnnotation id="Note_F_Skills"><bpmn2:text>Dedicated documented subflow; previews or replaces only framework skills.</bpmn2:text></bpmn2:textAnnotation>
<bpmn2:task id="F_Commands" name="Update commands only"/>
<bpmn2:textAnnotation id="Note_F_Commands"><bpmn2:text>Dedicated documented subflow; previews or replaces only slash commands.</bpmn2:text></bpmn2:textAnnotation>
<bpmn2:task id="F_Schema" name="Review or replace schema"/>
<bpmn2:textAnnotation id="Note_F_Schema"><bpmn2:text>Dedicated documented subflow; dry-run diff is recommended, while apply destructively replaces schema.</bpmn2:text></bpmn2:textAnnotation>
<bpmn2:task id="F_Upgrade" name="Upgrade tool snapshot"/>
<bpmn2:textAnnotation id="Note_F_Upgrade"><bpmn2:text>Re-runs install.sh, wipes snapshot, clones, validates kernel drift, relinks binary.</bpmn2:text></bpmn2:textAnnotation>
<bpmn2:task id="F_Recipe" name="Execute recipe workflow"/>
<bpmn2:textAnnotation id="Note_F_Recipe"><bpmn2:text>Archive, explore, plan, specs/topology/coverage are skill-driven and compose flow/tag/doctor.</bpmn2:text></bpmn2:textAnnotation>
<bpmn2:textAnnotation id="Annotation_0"><bpmn2:text>Ownership boundary
Bash: deterministic mechanics and validation.
Skills/slash commands: multi-step recipes.
Human or LLM: semantic refinement and reconciliation.</bpmn2:text></bpmn2:textAnnotation>
<bpmn2:textAnnotation id="Annotation_1"><bpmn2:text>Detailed implemented flows, documentation expectations, and evidence-based gaps are listed in user-flows.md and documentation-code-differences.md.</bpmn2:text></bpmn2:textAnnotation>
<bpmn2:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Intent"/>
<bpmn2:sequenceFlow id="Flow_2" sourceRef="Intent" targetRef="Dispatch"/>
<bpmn2:sequenceFlow id="Flow_3" sourceRef="Dispatch" targetRef="Gateway"/>
<bpmn2:sequenceFlow id="Flow_4" sourceRef="Gateway" targetRef="F_Doctor"/>
<bpmn2:sequenceFlow id="Flow_5" sourceRef="F_Doctor" targetRef="End"/>
<bpmn2:sequenceFlow id="Flow_6" sourceRef="Gateway" targetRef="F_Install"/>
<bpmn2:sequenceFlow id="Flow_7" sourceRef="F_Install" targetRef="End"/>
<bpmn2:sequenceFlow id="Flow_8" sourceRef="Gateway" targetRef="F_Uninstall"/>
<bpmn2:sequenceFlow id="Flow_9" sourceRef="F_Uninstall" targetRef="End"/>
<bpmn2:sequenceFlow id="Flow_10" sourceRef="Gateway" targetRef="F_Intake"/>
<bpmn2:sequenceFlow id="Flow_11" sourceRef="F_Intake" targetRef="End"/>
<bpmn2:sequenceFlow id="Flow_12" sourceRef="Gateway" targetRef="F_Tag"/>
<bpmn2:sequenceFlow id="Flow_13" sourceRef="F_Tag" targetRef="End"/>
<bpmn2:sequenceFlow id="Flow_14" sourceRef="Gateway" targetRef="F_Flow"/>
<bpmn2:sequenceFlow id="Flow_15" sourceRef="F_Flow" targetRef="End"/>
<bpmn2:sequenceFlow id="Flow_16" sourceRef="Gateway" targetRef="F_Update"/>
<bpmn2:sequenceFlow id="Flow_17" sourceRef="F_Update" targetRef="End"/>
<bpmn2:sequenceFlow id="Flow_18" sourceRef="Gateway" targetRef="F_Skills"/>
<bpmn2:sequenceFlow id="Flow_19" sourceRef="F_Skills" targetRef="End"/>
<bpmn2:sequenceFlow id="Flow_20" sourceRef="Gateway" targetRef="F_Commands"/>
<bpmn2:sequenceFlow id="Flow_21" sourceRef="F_Commands" targetRef="End"/>
<bpmn2:sequenceFlow id="Flow_22" sourceRef="Gateway" targetRef="F_Schema"/>
<bpmn2:sequenceFlow id="Flow_23" sourceRef="F_Schema" targetRef="End"/>
<bpmn2:sequenceFlow id="Flow_24" sourceRef="Gateway" targetRef="F_Upgrade"/>
<bpmn2:sequenceFlow id="Flow_25" sourceRef="F_Upgrade" targetRef="End"/>
<bpmn2:sequenceFlow id="Flow_26" sourceRef="Gateway" targetRef="F_Recipe"/>
<bpmn2:sequenceFlow id="Flow_27" sourceRef="F_Recipe" targetRef="End"/>
</bpmn2:process>
