  <bpmn2:process id="Process_Architecture" name="dot-llm internal architecture" isExecutable="false">
    <bpmn2:startEvent id="Start" name="dot-llm internal architecture" />
    <bpmn2:task id="Resolve" name="Resolve real script location&#10;_resolve_self" />
    <bpmn2:task id="Globals" name="Initialize runtime globals" />
    <bpmn2:task id="Source" name="Source common and command modules" />
    <bpmn2:exclusiveGateway id="Gateway" name="Select flow" />
    <bpmn2:endEvent id="End" name="Complete" />
    <bpmn2:task id="Task_Help" name="Help / discovery" />
    <bpmn2:task id="Task_Install" name="Install framework" />
    <bpmn2:task id="Task_Uninstall" name="Uninstall managed artifacts" />
    <bpmn2:task id="Task_Doctor" name="Run diagnostics" />
    <bpmn2:task id="Task_Update" name="Merge framework update" />
    <bpmn2:task id="Task_Intake" name="Fetch or re-sync issue" />
    <bpmn2:task id="Task_Flow" name="Guarded file operation" />
    <bpmn2:task id="Task_Tag" name="Marker-block operation" />
    <bpmn2:task id="Task_Upgrade" name="Replace tool snapshot" />
    <bpmn2:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Resolve" />
    <bpmn2:sequenceFlow id="Flow_2" sourceRef="Resolve" targetRef="Globals" />
    <bpmn2:sequenceFlow id="Flow_3" sourceRef="Globals" targetRef="Source" />
    <bpmn2:sequenceFlow id="Flow_4" sourceRef="Source" targetRef="Gateway" />
    <bpmn2:sequenceFlow id="Flow_5" sourceRef="Gateway" targetRef="Task_Help" />
    <bpmn2:sequenceFlow id="Flow_6" sourceRef="Task_Help" targetRef="End" />
    <bpmn2:sequenceFlow id="Flow_7" sourceRef="Gateway" targetRef="Task_Install" />
    <bpmn2:sequenceFlow id="Flow_8" sourceRef="Task_Install" targetRef="End" />
    <bpmn2:sequenceFlow id="Flow_9" sourceRef="Gateway" targetRef="Task_Uninstall" />
    <bpmn2:sequenceFlow id="Flow_10" sourceRef="Task_Uninstall" targetRef="End" />
    <bpmn2:sequenceFlow id="Flow_11" sourceRef="Gateway" targetRef="Task_Doctor" />
