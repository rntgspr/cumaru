<bpmndi:BPMNShape id="S_Link" bpmnElement="Link"><dc:Bounds x="1800" y="200" width="120" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Cleanup" bpmnElement="Cleanup"><dc:Bounds x="1970" y="200" width="120" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Doctor" bpmnElement="Doctor"><dc:Bounds x="2140" y="200" width="120" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_End" bpmnElement="End"><dc:Bounds x="2312" y="222" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_NoteSearch" bpmnElement="NoteSearch"><dc:Bounds x="700" y="40" width="180" height="60"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_NoteConflict" bpmnElement="NoteConflict"><dc:Bounds x="1380" y="440" width="200" height="60"/></bpmndi:BPMNShape>
