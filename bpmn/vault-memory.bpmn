<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_VaultMemory" targetNamespace="http://cumaru.local/bpmn">
<bpmn2:process id="Process_VaultMemory" name="vault-memory capture, distill, link, clean" isExecutable="false">
<bpmn2:startEvent id="Start" name="Source arrives"/>
<bpmn2:exclusiveGateway id="GwSource" name="Single item or whole document?"/>
<bpmn2:task id="Capture" name="cumaru-capture: inbox/&lt;id&gt;/"/>
<bpmn2:task id="Bulk" name="Bulk capture: keep source in attachments/&lt;slug&gt;/"/>
<bpmn2:task id="Map" name="cumaru map: one capture per section"/>
<bpmn2:exclusiveGateway id="GwSourceJoin"/>
<bpmn2:task id="Search" name="cumaru-distill: search before write (context, tree, aliases)"/>
<bpmn2:exclusiveGateway id="GwClass" name="Classify subject"/>
<bpmn2:task id="Update" name="Same subject: update node"/>
<bpmn2:task id="Similar" name="Neighbor: new node + similar-to both sides"/>
<bpmn2:task id="New" name="New: create node or type: term"/>
<bpmn2:exclusiveGateway id="GwClassJoin"/>
<bpmn2:task id="Frontmatter" name="Set aliases, authority, valid-from/until, derived-from span"/>
<bpmn2:exclusiveGateway id="GwConflict" name="Conflicts with a node?"/>
<bpmn2:task id="Rank" name="Higher authority: canonical / superseded + superseded-by"/>
<bpmn2:task id="Dispute" name="Equal rank: contradicts + disputed, ask user"/>
<bpmn2:exclusiveGateway id="GwConflictJoin"/>
<bpmn2:task id="Link" name="cumaru-link: reciprocal edges, resolve disputed"/>
<bpmn2:task id="Cleanup" name="Reconcile provenance, remove inbox with confirmation"/>
<bpmn2:task id="Doctor" name="cumaru doctor"/>
<bpmn2:endEvent id="End" name="One node per fact"/>
<bpmn2:textAnnotation id="NoteSearch"><bpmn2:text>Decision recorded in the node's ## Notes. One alias belongs to one node.</bpmn2:text></bpmn2:textAnnotation>
<bpmn2:association id="AssocSearch" sourceRef="Search" targetRef="NoteSearch"/>
<bpmn2:textAnnotation id="NoteConflict"><bpmn2:text>Ranking lives in the domain.md authority tag. Superseded nodes are never deleted.</bpmn2:text></bpmn2:textAnnotation>
<bpmn2:association id="AssocConflict" sourceRef="GwConflict" targetRef="NoteConflict"/>
<bpmn2:textAnnotation id="NoteDoctor"><bpmn2:text>Doctor checks field presence only; alias collision and open disputes are not detected yet.</bpmn2:text></bpmn2:textAnnotation>
<bpmn2:association id="AssocDoctor" sourceRef="Doctor" targetRef="NoteDoctor"/>
<bpmn2:sequenceFlow id="F01" sourceRef="Start" targetRef="GwSource"/>
<bpmn2:sequenceFlow id="F02" name="item" sourceRef="GwSource" targetRef="Capture"/>
<bpmn2:sequenceFlow id="F03" name="document" sourceRef="GwSource" targetRef="Bulk"/>
<bpmn2:sequenceFlow id="F04" sourceRef="Bulk" targetRef="Map"/>
<bpmn2:sequenceFlow id="F05" sourceRef="Capture" targetRef="GwSourceJoin"/>
<bpmn2:sequenceFlow id="F06" sourceRef="Map" targetRef="GwSourceJoin"/>
<bpmn2:sequenceFlow id="F07" sourceRef="GwSourceJoin" targetRef="Search"/>
<bpmn2:sequenceFlow id="F08" sourceRef="Search" targetRef="GwClass"/>
<bpmn2:sequenceFlow id="F09" name="same" sourceRef="GwClass" targetRef="Update"/>
<bpmn2:sequenceFlow id="F10" name="neighbor" sourceRef="GwClass" targetRef="Similar"/>
<bpmn2:sequenceFlow id="F11" name="new" sourceRef="GwClass" targetRef="New"/>
<bpmn2:sequenceFlow id="F12" sourceRef="Update" targetRef="GwClassJoin"/>
<bpmn2:sequenceFlow id="F13" sourceRef="Similar" targetRef="GwClassJoin"/>
<bpmn2:sequenceFlow id="F14" sourceRef="New" targetRef="GwClassJoin"/>
<bpmn2:sequenceFlow id="F15" sourceRef="GwClassJoin" targetRef="Frontmatter"/>
<bpmn2:sequenceFlow id="F16" sourceRef="Frontmatter" targetRef="GwConflict"/>
<bpmn2:sequenceFlow id="F17" name="ranks differ" sourceRef="GwConflict" targetRef="Rank"/>
<bpmn2:sequenceFlow id="F18" name="no conflict" sourceRef="GwConflict" targetRef="GwConflictJoin"/>
<bpmn2:sequenceFlow id="F19" name="equal or unknown" sourceRef="GwConflict" targetRef="Dispute"/>
<bpmn2:sequenceFlow id="F20" sourceRef="Rank" targetRef="GwConflictJoin"/>
<bpmn2:sequenceFlow id="F21" sourceRef="Dispute" targetRef="GwConflictJoin"/>
<bpmn2:sequenceFlow id="F22" sourceRef="GwConflictJoin" targetRef="Link"/>
<bpmn2:sequenceFlow id="F23" sourceRef="Link" targetRef="Cleanup"/>
<bpmn2:sequenceFlow id="F24" sourceRef="Cleanup" targetRef="Doctor"/>
<bpmn2:sequenceFlow id="F25" sourceRef="Doctor" targetRef="End"/>
</bpmn2:process>
<bpmndi:BPMNDiagram id="Diagram_VaultMemory">
<bpmndi:BPMNPlane id="Plane_VaultMemory" bpmnElement="Process_VaultMemory">
<bpmndi:BPMNShape id="S_Start" bpmnElement="Start"><dc:Bounds x="100" y="222" width="36" height="36"/></bpmndi:BPMNShape>
