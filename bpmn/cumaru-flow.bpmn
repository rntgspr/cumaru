<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Flow" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mangue" exporterVersion="0.1.0">
  <bpmn:process id="CumaruFlow" name="Execute a configured workflow" isExecutable="false">
    <bpmn:startEvent id="Start" name="Workflow invoked">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Named" name="Flow name supplied?">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Choose" name="Choose a configured flow">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Doctor" name="Run cumaru doctor">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Healthy" name="Execution reliable?">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Load" name="Load and validate named workflow">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Valid" name="Workflow valid?">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Remaining" name="Steps remaining?">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Select" name="Select lexically first ready step">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Invoke" name="Invoke installed skill with original scope">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Succeeded" name="Success supported by evidence?">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Mark" name="Mark step complete for this invocation">
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="ReportBlocker" name="Report blocker and affected step">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Blocked" name="Stopped; new invocation required">
      <bpmn:incoming>f18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Done" name="Workflow complete">
      <bpmn:incoming>f12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="Start" targetRef="Named" />
    <bpmn:sequenceFlow id="f2" name="No" sourceRef="Named" targetRef="Choose" />
    <bpmn:sequenceFlow id="f3" name="Yes" sourceRef="Named" targetRef="Doctor" />
    <bpmn:sequenceFlow id="f4" sourceRef="Choose" targetRef="Doctor" />
    <bpmn:sequenceFlow id="f5" sourceRef="Doctor" targetRef="Healthy" />
    <bpmn:sequenceFlow id="f6" name="Yes" sourceRef="Healthy" targetRef="Load" />
    <bpmn:sequenceFlow id="f7" name="No" sourceRef="Healthy" targetRef="ReportBlocker" />
    <bpmn:sequenceFlow id="f8" sourceRef="Load" targetRef="Valid" />
    <bpmn:sequenceFlow id="f9" name="Yes" sourceRef="Valid" targetRef="Remaining" />
    <bpmn:sequenceFlow id="f10" name="No" sourceRef="Valid" targetRef="ReportBlocker" />
    <bpmn:sequenceFlow id="f11" name="Yes" sourceRef="Remaining" targetRef="Select" />
    <bpmn:sequenceFlow id="f12" name="No" sourceRef="Remaining" targetRef="Done" />
    <bpmn:sequenceFlow id="f13" sourceRef="Select" targetRef="Invoke" />
    <bpmn:sequenceFlow id="f14" sourceRef="Invoke" targetRef="Succeeded" />
    <bpmn:sequenceFlow id="f15" name="Yes" sourceRef="Succeeded" targetRef="Mark" />
    <bpmn:sequenceFlow id="f16" name="Failure, input, authorization or insufficient evidence" sourceRef="Succeeded" targetRef="ReportBlocker" />
    <bpmn:sequenceFlow id="f17" sourceRef="Mark" targetRef="Remaining" />
    <bpmn:sequenceFlow id="f18" sourceRef="ReportBlocker" targetRef="Blocked" />
    <bpmn:textAnnotation id="Rules">
      <bpmn:text>Ready steps have all prerequisites completed. Recompute readiness after success; do not rerun completed steps or bypass a blocked prerequisite. State is not persisted. On a step blocker, report its name, skill and reason.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="a1" sourceRef="Select" targetRef="Rules" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Flow">
    <bpmndi:BPMNPlane id="Plane_Flow" bpmnElement="CumaruFlow">
      <bpmndi:BPMNShape id="s_Start" bpmnElement="Start">
        <dc:Bounds x="-28" y="252" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_Named" bpmnElement="Named">
        <dc:Bounds x="140" y="245" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_Choose" bpmnElement="Choose">
        <dc:Bounds x="105" y="60" width="120" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_Doctor" bpmnElement="Doctor">
        <dc:Bounds x="250" y="240" width="120" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_Healthy" bpmnElement="Healthy">
        <dc:Bounds x="420" y="245" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_Load" bpmnElement="Load">
        <dc:Bounds x="530" y="240" width="140" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_Valid" bpmnElement="Valid">
        <dc:Bounds x="720" y="245" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_Remaining" bpmnElement="Remaining">
        <dc:Bounds x="835" y="245" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_Select" bpmnElement="Select">
        <dc:Bounds x="940" y="240" width="140" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_Invoke" bpmnElement="Invoke">
        <dc:Bounds x="1130" y="240" width="150" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_Succeeded" bpmnElement="Succeeded">
        <dc:Bounds x="1330" y="245" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_Mark" bpmnElement="Mark">
        <dc:Bounds x="1285" y="100" width="140" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_Report" bpmnElement="ReportBlocker">
        <dc:Bounds x="950" y="420" width="150" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_Blocked" bpmnElement="Blocked">
        <dc:Bounds x="1232" y="352" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_Done" bpmnElement="Done">
        <dc:Bounds x="842" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_Rules" bpmnElement="Rules">
        <dc:Bounds x="945" y="20" width="290" height="110" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ea1" bpmnElement="a1">
        <di:waypoint x="1010" y="240" />
        <di:waypoint x="1010" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e1" bpmnElement="f1">
        <di:waypoint x="8" y="270" />
        <di:waypoint x="140" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e2" bpmnElement="f2">
        <di:waypoint x="165" y="245" />
        <di:waypoint x="165" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e3" bpmnElement="f3">
        <di:waypoint x="190" y="270" />
        <di:waypoint x="250" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e4" bpmnElement="f4">
        <di:waypoint x="225" y="90" />
        <di:waypoint x="310" y="90" />
        <di:waypoint x="310" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e5" bpmnElement="f5">
        <di:waypoint x="370" y="270" />
